# Required — the LLM provider backing ClickyWeb's chat/tool-calling. Defaults to
# Cerebras (free tier, 1M tokens/day, OpenAI-compatible, supports tool calling).
CEREBRAS_API_KEY=your-cerebras-key
# LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# LLM_API_KEY=sk-or-v1-your-openrouter-key

# Optional — vision fallback for canvas/custom-UI pages (Pro+ plan only). Cerebras's
# free models are text-only, so this needs a separate vision-capable provider.
VISION_API_KEY=sk-or-v1-your-openrouter-key
# VISION_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# VISION_MODEL=openai/gpt-4o-mini

# Optional — leave unset to use the in-memory usage store (fine for testing,
# resets on every restart). Set both to persist usage/plans in Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — leave unset to disable billing (free plan only).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PROPLUS=
CHECKOUT_SUCCESS_URL=https://example.com/success
CHECKOUT_CANCEL_URL=https://example.com/cancel
