# Required
OPENROUTER_API_KEY=sk-or-v1-your-own-openrouter-key

# Optional — leave unset to use the in-memory usage store (fine for testing,
# resets on every restart). Set both to persist usage/plans in Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — leave unset to disable billing (free plan only, no upgrade button
# will work, /billing/* routes return a friendly error instead of crashing).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_POWER=
CHECKOUT_SUCCESS_URL=https://example.com/success
CHECKOUT_CANCEL_URL=https://example.com/cancel
